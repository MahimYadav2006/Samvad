# Ignore node_modules in both backend and frontend
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Ignore environment files
**/.env
**/.env.*.local
**/.env.local

Frontend/config.env
Backend/config.env
*.env

#  Ignore build and dist directories
Frontend/build/
Frontend/.next/
Frontend/.nuxt/
Backend/dist/

#Ignore temporary React files
Frontend/.cache/
Frontend/.parcel-cache/
Frontend/.eslintcache
Frontend/public/static/

# Ignore TypeScript build files (if used)
**/*.tsbuildinfo

# Ignore logs
logs
*.log
logs/*.log

# Ignore OS + IDE junk
.DS_Store
Thumbs.db
*.swp

# Ignore VSCode and JetBrains IDE configs
.vscode/
.idea/

# Ignore coverage reports
**/coverage/
**/coverage-final.json
**/lcov-report/
**/lcov.info

#Ignore test output
**/jest-test-results.json

#Ignore uploads/temp files (custom if needed)
**/uploads/
**/tmp/
**/temp/

